# --- Обязательные ключи (только на сервере!) ---
OPENAI_API_KEY=            # распознавание речи (Whisper, https://platform.openai.com/api-keys)
ANTHROPIC_API_KEY=         # анализ смысла и выбор моментов (https://console.anthropic.com)

# --- Модели (можно менять) ---
ASR_MODEL=whisper-1        # нужен ответ с word-level таймстемпами
LLM_MODEL=claude-sonnet-5-5

# --- Хранилище и лимиты ---
PORT=3000
DATA_DIR=./data            # на Render: /data (подключите Persistent Disk)
MAX_UPLOAD_MB=2048
MAX_SOURCE_MINUTES=180
MAX_CONCURRENT_JOBS=1
MIN_FREE_GB=2
RETENTION_DAYS=7
MAX_OUTPUT_QUALITY=1080    # потолок качества на сервере: 720 | 1080 | 1440 | 2160
MAX_SOURCE_HEIGHT=1080     # максимум высоты при скачивании с YouTube

# --- YouTube ---
YT_DLP_ENABLED=true        # false = только загрузка файлов
# Используйте только для своих или лицензированных материалов.
