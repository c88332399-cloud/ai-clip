# --- Обязательно (только на сервере, в клиентский код и GitHub не попадает) ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey — распознавание речи и анализ смысла

# --- Модель Gemini (можно менять) ---
GEMINI_MODEL=gemini-2.5-flash       # анализ моментов и перевод субтитров
# GEMINI_ASR_MODEL=gemini-2.5-flash # по умолчанию = GEMINI_MODEL

# --- Хранилище и лимиты ---
PORT=3000
DATA_DIR=./data            # на Render: /data (подключите Persistent Disk, иначе данные пропадают при перезапуске)
MAX_UPLOAD_MB=2048
MAX_SOURCE_MINUTES=180
MAX_CONCURRENT_JOBS=1
MIN_FREE_GB=2
RETENTION_DAYS=7
MAX_PROJECTS_PER_HOUR=20   # лимит запусков на одного посетителя (защита квоты Gemini)
MAX_OUTPUT_QUALITY=1080    # потолок качества на сервере: 720 | 1080 | 1440 | 2160
MAX_SOURCE_HEIGHT=1080     # максимум высоты при скачивании с YouTube

# --- Ссылки ---
YT_DLP_ENABLED=true        # false = только файлы и прямые ссылки на .mp4
# Используйте только для своих или лицензированных материалов.
